#!/usr/bin/env python3
import sys, json, subprocess, http.server, socketserver, os
if sys.argv[1:] != ["serve"]: sys.exit(1)
subprocess.Popen(["sleep","600"])   # "runner" filho
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self,*a): pass
    def do_GET(self):
        self.send_response(200); self.send_header("Content-Type","application/json"); self.end_headers(); self.wfile.write(json.dumps({"models":[{"name":"x"}]}).encode())
socketserver.TCPServer.allow_reuse_address=True
socketserver.TCPServer(("127.0.0.1",11999),H).serve_forever()
